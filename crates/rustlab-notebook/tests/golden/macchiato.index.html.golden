<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Index — Notebook Index</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  :root {
    --rl-bg: #24273a;
    --rl-bg-secondary: #1e2030;
    --rl-text: #cad3f5;
    --rl-text-dim: #a5adcb;
    --rl-border: #363a4f;
    --rl-border-subtle: #494d64;
    --rl-accent-primary: #c6a0f6;
    --rl-accent-secondary: #8aadf4;
    --rl-accent-tertiary: #7dc4e4;
    --rl-code-bg: #181926;
    --rl-output-bg: #1e2030;
    --rl-inline-code-bg: #363a4f;
    --rl-error-bg: #1e0a0a;
    --rl-error-text: #ed8796;
    --rl-plot-bg: #24273a;
    --rl-plot-grid: rgba(150,150,180,0.3);
    --rl-syn-keyword: #c6a0f6;
    --rl-syn-function: #8aadf4;
    --rl-syn-number: #f5a97f;
    --rl-syn-string: #a6da95;
    --rl-syn-comment: #7c8199;
    --rl-syn-operator: #91d7e3;
    --rl-footer-text: #898ea5;
    --rl-cm-mark-bg: #565253;
    --rl-cm-note-bg: #1e2030;
    --rl-cm-note-border: #8aadf4;
    --rl-dx-add-bar: #a6da95;
    --rl-dx-mod-bar: #8aadf4;
    --rl-dx-del-bar: #f19fab;
    --rl-dx-add-line: #161a1a;
    --rl-dx-del-line: #1e181e;
    --rl-dx-add-word: #414e4e;
    --rl-dx-del-word: #514153;
  }
  html { color-scheme: dark; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--rl-bg, #24273a);
    color: var(--rl-text, #cad3f5);
    display: flex;
    justify-content: center;
    min-height: 100vh;
    padding: 3rem 1.5rem;
  }
  main {
    max-width: 720px;
    width: 100%;
  }
  h1 {
    font-size: 2rem;
    color: var(--rl-accent-primary, #c6a0f6);
    margin-bottom: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rl-border, #363a4f);
  }
  .subtitle {
    color: var(--rl-text-dim, #a5adcb);
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }
  ul {
    list-style: none;
    padding: 0;
  }
  li {
    margin-bottom: 0.5rem;
  }
  a {
    display: block;
    padding: 0.8rem 1.2rem;
    background: var(--rl-bg-secondary, #1e2030);
    border: 1px solid var(--rl-border, #363a4f);
    border-radius: 8px;
    color: var(--rl-accent-secondary, #8aadf4);
    text-decoration: none;
    font-size: 1.05rem;
    transition: background 0.15s, border-color 0.15s;
  }
  a:hover {
    background: var(--rl-border, #363a4f);
    border-color: var(--rl-accent-secondary, #8aadf4);
  }
  footer {
    color: var(--rl-footer-text, #898ea5);
    font-size: 0.8rem;
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rl-border, #363a4f);
  }
  .intro {
    color: var(--rl-text, #cad3f5);
    margin-bottom: 2rem;
  }
  .intro p, .intro ul, .intro ol { margin-bottom: 1rem; }
  .intro h2 { color: var(--rl-accent-primary, #c6a0f6); margin: 1.5rem 0 0.5rem; }
  .intro a {
    display: inline; padding: 0; background: transparent; border: 0;
    color: var(--rl-accent-secondary, #8aadf4); text-decoration: underline;
  }
  .intro a:visited { color: var(--rl-accent-primary, #c6a0f6); }
  .intro a:hover { background: transparent; color: var(--rl-accent-tertiary, #7dc4e4); }
  body.has-files {
    display: block;
    padding: 0;
    justify-content: flex-start;
  }
  body.has-files main {
    margin-left: max(var(--fb-w, 16.5rem), calc(50% - 360px));
    padding: 3rem 1.5rem 2rem;
  }

</style>
</head>
<body>
<main>
<h1>Index</h1>
<p class="subtitle">1 notebook</p>
<div class="intro prose">
<p><a href="sample.html">Sample</a></p></div>
<ul>
  <li><a href="sample.html">Sample</a></li>
</ul>
<footer>Generated by rustlab-notebook</footer>
</main>
</body>
</html>
