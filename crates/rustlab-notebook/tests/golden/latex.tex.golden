\definecolor{rldim}{HTML}{56586a}
\definecolor{rlh1}{HTML}{7113ec}
\definecolor{rlh2}{HTML}{094dd3}
\definecolor{rlh3}{HTML}{12747a}
\definecolor{rlrule}{HTML}{7113ec}
\definecolor{rllink}{HTML}{094dd3}
\definecolor{rlkw}{HTML}{802cee}
\definecolor{rlfn}{HTML}{0a55ea}
\definecolor{rlnum}{HTML}{ad4001}
\definecolor{rlstr}{HTML}{2d711e}
\definecolor{rlcom}{HTML}{5e6376}
\definecolor{rlop}{HTML}{116e74}
\definecolor{rlcodebg}{HTML}{dce0e8}
\definecolor{rloutbg}{HTML}{e6e9ef}
\definecolor{rlpanel}{HTML}{e6e9ef}
\definecolor{rlthead}{HTML}{ebecef}
\definecolor{rltstripe}{HTML}{f4f4f6}
\definecolor{rltrule}{HTML}{c9cad2}
\definecolor{rlborder}{HTML}{ccd0da}
\definecolor{rlerrbg}{HTML}{fce4e4}
\definecolor{rlerrfg}{HTML}{c60e36}

\usepackage{tcolorbox}
\tcbuselibrary{breakable,skins}
\usepackage{fancyvrb}
\usepackage{fvextra}
\usepackage{sectsty}
\usepackage{float}
\usepackage{booktabs}
\usepackage{tabularx}
\usepackage{xltabular}
\usepackage[normalem]{ulem}
\usepackage{hyperref}
\hypersetup{colorlinks=true,linkcolor=rllink,urlcolor=rllink}
% breaklines wraps at spaces; breakanywhere wraps a token that is still
% wider than the panel (a printed line with no spaces).
\DefineVerbatimEnvironment{rlverb}{Verbatim}{fontsize=\small,breaklines,breakanywhere}
\tcbset{
  rlbase/.style={
    breakable,
    enhanced,
    arc=1.5mm,
    boxrule=0.4pt,
    leftrule=3pt,
    left=2.2mm,
    right=2mm,
    top=1.1mm,
    bottom=1.1mm,
    before skip=0.2em,
    after skip=0.2em,
    colframe=rlborder,
    overlay unbroken and first={
      \draw[rlrule,line width=2.6pt] ([xshift=1.3pt]frame.north west) -- ([xshift=1.3pt]frame.south west);
    },
    overlay middle and last={
      \draw[rlrule,line width=2.6pt] ([xshift=1.3pt]frame.north west) -- ([xshift=1.3pt]frame.south west);
    },
  },
}
\newtcolorbox{rlsource}{rlbase, colback=rlcodebg, colupper=rltext, after skip=0.28em}
\newtcolorbox{rloutput}{rlbase, colback=rloutbg, colupper=rldim, before skip=0.22em}
\newtcolorbox{rlerror}{rlbase, colback=rlerrbg, colupper=rlerrfg, colframe=rlerrfg, before skip=0.22em}
\newtcolorbox{rlcallout}[2]{
  breakable, enhanced, arc=1.5mm,
  boxrule=0pt, leftrule=4pt,
  colback=rlpanel, colframe=#1, coltitle=#1,
  fonttitle=\bfseries\sffamily,
  title={#2},
  left=2.5mm, right=2.5mm, top=1.4mm, bottom=1.4mm,
  before skip=0.75em, after skip=0.75em,
}
\newtcolorbox{rlexercise}{
  breakable, enhanced, arc=2mm,
  boxrule=0.6pt, colframe=rlborder, colback=rlpanel,
  left=2.5mm, right=2.5mm, top=1.5mm, bottom=1.5mm,
  before skip=0.9em, after skip=0.9em,
}
% emergencystretch lets a heading that is only a few points too wide
% break at a zero-width point instead of running into the margin.
\sectionfont{\color{rlh1}\normalfont\Large\bfseries\setlength{\emergencystretch}{3em}}
\subsectionfont{\color{rlh2}\normalfont\large\bfseries\setlength{\emergencystretch}{3em}}
\subsubsectionfont{\color{rlh3}\normalfont\normalsize\bfseries\setlength{\emergencystretch}{3em}}
\setcounter{secnumdepth}{-1}
\title{Sample}
\date{}

\begin{document}
\color{rltext}
\maketitle

\hypertarget{sample}{}
\section{Sample}

A \href{https://example.com/notes}{link} and $E=mc^2$.

