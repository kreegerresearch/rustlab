<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sample</title>
<script src="/assets/plotly.min.js"></script>
<link rel="stylesheet" href="/assets/katex/katex.min.css">
<script defer src="/assets/katex/katex.min.js"></script>
<script defer src="/assets/katex/contrib/auto-render.min.js"></script>
<script>
// Page init. Lives in a real script element (not on* attributes) so it also
// runs under the watch server's CSP, which forbids inline event handlers.
// `defer` scripts finish before DOMContentLoaded, so KaTeX is loaded here.
document.addEventListener('DOMContentLoaded', () => {
  if (window.renderMathInElement) {
    renderMathInElement(document.body, {
      delimiters: [
        {left: '\\[', right: '\\]', display: true},
        {left: '\\(', right: '\\)', display: false}
      ]
    });
  }
});
// Sidebar toggle (narrow viewports). Delegated so it survives the live
// server swapping the button on re-render.
document.addEventListener('click', (e) => {
  if (e.target && e.target.closest && e.target.closest('button.nav-toggle')) {
    const nav = document.querySelector('nav.sidebar');
    if (nav) nav.classList.toggle('open');
  }
});
</script>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { color-scheme: light; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--rl-bg, #eff1f5);
    color: var(--rl-text, #4c4f69);
    display: flex;
    min-height: 100vh;
  }
  /* Height of the fixed topbar; the sidebar and main both clear it.
     `--rl-*` tokens come from the resolved ThemeColors so chrome can
     restyle without rewriting the whole stylesheet. Rules below use
     var(--rl-…, <literal>) so missing tokens keep today's colors. */
  :root {
    --topbar-h: 2.6rem;
    --rl-bg: #eff1f5;
    --rl-bg-secondary: #e6e9ef;
    --rl-text: #4c4f69;
    --rl-text-dim: #56586a;
    --rl-border: #ccd0da;
    --rl-border-subtle: #bcc0cc;
    --rl-accent-primary: #7113ec;
    --rl-accent-secondary: #094dd3;
    --rl-accent-tertiary: #12747a;
    --rl-code-bg: #dce0e8;
    --rl-output-bg: #e6e9ef;
    --rl-inline-code-bg: #ccd0da;
    --rl-error-bg: #fce4e4;
    --rl-error-text: #c60e36;
    --rl-plot-bg: #eff1f5;
    --rl-plot-grid: rgba(100,100,120,0.2);
    --rl-syn-keyword: #802cee;
    --rl-syn-function: #0a55ea;
    --rl-syn-number: #ad4001;
    --rl-syn-string: #2d711e;
    --rl-syn-comment: #5e6376;
    --rl-syn-operator: #116e74;
    --rl-footer-text: #686d82;
    --rl-cm-mark-bg: #ebd8bf;
    --rl-cm-note-bg: #e6e9ef;
    --rl-cm-note-border: #094dd3;
    --rl-dx-add-bar: #307820;
    --rl-dx-mod-bar: #094dd3;
    --rl-dx-del-bar: #d20f39;
    --rl-dx-add-line: #d7e4db;
    --rl-dx-del-line: #ebdce3;
    --rl-dx-add-word: #c9dfc9;
    --rl-dx-del-word: #eac8d3;
    --rl-accent: var(--rl-accent-primary, #7113ec);
  }
  /* ── Navigation sidebar (in-page TOC) ── */
  nav.sidebar {
    position: fixed;
    top: var(--topbar-h);
    left: var(--fb-w, 0px);
    width: 220px;
    height: calc(100vh - var(--topbar-h));
    background: var(--rl-bg-secondary, #e6e9ef);
    border-right: 1px solid var(--rl-border, #ccd0da);
    padding: 1.5rem 0;
    overflow-y: auto;
    /* Unbreakable content (a wide KaTeX formula) clips at the column edge
       rather than painting over `main` or growing a stray h-scrollbar. */
    overflow-x: hidden;
    z-index: 100;
    transition: transform 0.25s ease;
  }
  nav.sidebar .nav-title {
    overflow-wrap: anywhere;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--rl-accent-primary, #7113ec);
    padding: 0 1rem 1rem;
    border-bottom: 1px solid var(--rl-border, #ccd0da);
    margin-bottom: 0.5rem;
  }
  nav.sidebar a {
    display: block;
    padding: 0.4rem 1rem;
    color: var(--rl-text-dim, #56586a);
    text-decoration: none;
    font-size: 0.9rem;
    transition: background 0.15s, color 0.15s;
    /* Headings can be long, and KaTeX typesets any inline math in them
       (auto-render walks the whole body, sidebar included). Text wraps;
       KaTeX output is internally nowrap, so an unbreakable formula wider
       than the column is clipped by the sidebar's overflow-x instead —
       it must never leak over the content. */
    overflow-wrap: anywhere;
  }
  nav.sidebar .katex {
    font-size: 0.95em;
  }
  nav.sidebar a:hover {
    background: var(--rl-border, #ccd0da);
    color: var(--rl-text, #4c4f69);
  }
  nav.sidebar a.h2 {
    padding-left: 1.8rem;
    font-size: 0.85rem;
  }
  nav.sidebar a.h3 {
    padding-left: 2.6rem;
    font-size: 0.8rem;
  }
  /* ── Hamburger toggle (hidden on desktop) ── */
  .nav-toggle {
    display: none;
    position: fixed;
    top: 0.7rem;
    left: 0.7rem;
    z-index: 200;
    background: var(--rl-border, #ccd0da);
    border: 1px solid var(--rl-border-subtle, #bcc0cc);
    border-radius: 6px;
    color: var(--rl-text, #4c4f69);
    font-size: 1.3rem;
    width: 2.4rem;
    height: 2.4rem;
    cursor: pointer;
    line-height: 1;
  }
  /* ── Main content ── */
  main {
    /* Centre the 960px column in the space right of the sidebar on wide
       displays, never under it. An auto right margin does NOT do this:
       with `flex: 1` the item fills the line before `max-width` clamps
       it, and the freed space all lands on the single auto margin —
       position unchanged, prose pinned against the sidebar. (Measured:
       the auto-right-margin form left main at x=220 on a 1600px
       viewport; this puts it at 320, like the old `margin: 0 auto`.) */
    margin-left: max(220px, calc(50% - 480px));
    flex: 1;
    padding: calc(var(--topbar-h) + 2rem) 2.5rem 2rem;
    max-width: 960px;
    min-width: 0;
  }
  /* ── Topbar (between-notebook nav) ──
     Fixed rather than sticky: it spans the full width above the sidebar, so
     it cannot participate in the body's flex row. */
  .topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--topbar-h);
    z-index: 150;
    background: var(--rl-bg-secondary, #e6e9ef);
    border-bottom: 1px solid var(--rl-border, #ccd0da);
    padding: 0 1.2rem;
    font-size: 0.85rem;
    color: var(--rl-text-dim, #56586a);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .topbar a {
    color: var(--rl-accent-secondary, #094dd3);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .topbar a:hover {
    text-decoration: underline;
  }
  /* Prev/next flank the breadcrumb and yield space to it when cramped.
     The Index link must NOT shrink: `overflow: hidden` gives every topbar
     link a zero flex minimum, and on a narrow screen the crumb squeezed
     "Index" — the one link back to the collection root — to a 5px sliver. */
  .topbar a.index {
    flex: 0 0 auto;
  }
  .topbar a.prev, .topbar a.next {
    flex: 0 1 auto;
    max-width: 22%;
  }
  .topbar a.next {
    margin-left: auto;
    text-align: right;
  }
  .topbar .crumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    /* Claim the leftover width. Flex items default to min-width:auto and
       refuse to shrink below their content, so without this the fixed-size
       prev/next links won and the title — the one label saying where you
       are — collapsed to nothing on a narrow screen. `.current` keeps
       min-width:0 so it ellipsises instead. */
    flex: 1 1 auto;
  }
  .topbar .sep {
    color: var(--rl-text-dim, #56586a);
  }
  .topbar .current {
    color: var(--rl-text, #4c4f69);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }
  /* Present only when at least one code cell failed. Sits beside the
     title and jumps to `#rl-error-1`. Batch HTML and watch share this
     markup; watch syncs the top bar on a chrome change. */
  .topbar a.rl-errors {
    flex: 0 0 auto;
    margin-left: 0.35rem;
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--rl-error-text, #c60e36);
    border-radius: 999px;
    color: var(--rl-error-text, #c60e36);
    background: var(--rl-error-bg, #fce4e4);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .topbar a.rl-errors:hover {
    text-decoration: underline;
  }
  /* Anchor targets must clear the fixed topbar. Without this a link scrolls
     its target to y=0, which is behind the bar — the heading you clicked is
     the one thing you cannot see. Applies to EVERY id, not just the
     generated `heading-N` ones: explicit `{#anchor}` headings, footnote
     back-references and block ids are all link targets too. */
  [id] {
    scroll-margin-top: calc(var(--topbar-h) + 0.75rem);
  }
  /* No headings, no sidebar: the column centres in the full viewport.
     A collection file browser, when present, adds `--fb-w` on the left
     of the TOC (or in place of it, when there is no TOC). */
  body.no-toc main {
    margin-left: max(0px, calc(50% - 480px));
  }
  body.has-files main {
    margin-left: max(calc(220px + var(--fb-w)), calc(50% - 480px));
  }
  body.has-files.no-toc main {
    margin-left: max(var(--fb-w), calc(50% - 480px));
  }
  .prose {
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .prose h1 {
    font-size: 1.8rem;
    color: var(--rl-accent-primary, #7113ec);
    margin: 2rem 0 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--rl-border, #ccd0da);
  }
  .prose h2 {
    font-size: 1.4rem;
    color: var(--rl-accent-secondary, #094dd3);
    margin: 1.8rem 0 0.8rem;
  }
  .prose h3 {
    font-size: 1.15rem;
    color: var(--rl-accent-tertiary, #12747a);
    margin: 1.4rem 0 0.6rem;
  }
  .prose p {
    margin-bottom: 1rem;
  }
  /* Prose/callout/exercise links. Without this, UA-default `#0000EE` /
     visited `#551A8B` sit on the dark page background at ~2:1 contrast.
     More-specific `.topbar a` / `.page-nav a` / `nav.sidebar a` keep
     their own colors. */
  .prose a, .callout a, .exercise a {
    color: var(--rl-accent-secondary, #094dd3);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .prose a:visited, .callout a:visited, .exercise a:visited {
    color: var(--rl-accent-primary, #7113ec);
  }
  .prose a:hover, .callout a:hover, .exercise a:hover {
    color: var(--rl-accent-tertiary, #12747a);
  }
  .prose code {
    background: var(--rl-inline-code-bg, #ccd0da);
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    font-size: 0.9em;
  }
  .prose table {
    border-collapse: collapse;
    margin: 1rem 0;
  }
  .prose th, .prose td {
    border: none;
    border-bottom: 1px solid color-mix(in srgb, var(--rl-text, #4c4f69) 30%, var(--rl-bg, #eff1f5));
    padding: 0.5rem 0.8rem;
    text-align: left;
  }
  .prose th {
    background: color-mix(in srgb, var(--rl-text, #4c4f69) 11%, var(--rl-bg, #eff1f5));
    color: var(--rl-accent-primary, #7113ec);
    font-weight: 600;
    border-bottom: 1px solid color-mix(in srgb, var(--rl-text, #4c4f69) 30%, var(--rl-bg, #eff1f5));
  }
  .prose tbody tr:nth-child(even) td {
    background: color-mix(in srgb, var(--rl-text, #4c4f69) 6%, var(--rl-bg, #eff1f5));
  }
  .prose img, .callout img {
    max-width: 100%;
    height: auto;
  }
  .missing-figure {
    color: var(--rl-text-dim, #56586a);
    font-style: italic;
  }
  .prose ul, .prose ol {
    margin: 0.5rem 0 1rem 1.5rem;
  }
  .prose li {
    margin-bottom: 0.3rem;
  }
  .prose blockquote {
    border-left: 3px solid var(--rl-accent-primary, #7113ec);
    padding-left: 1rem;
    color: var(--rl-text-dim, #56586a);
    margin: 1rem 0;
  }
  .code-block {
    margin-bottom: 1.5rem;
  }
  /* Source, printed output, and errors. The accent rule marks the cell.
     Plots are siblings of this wrapper, so they stay full width. */
  .rl-cell {
    margin: 0.2rem 0 0.35rem 0.15rem;
    padding: 0.05rem 0 0.05rem 0.85rem;
    border-left: 3px solid var(--rl-accent-primary, #7113ec);
  }
  /* A cell that failed. Same rule, error color, so the red pre is not
     the only signal when the page is long. */
  .rl-cell.rl-cell-error {
    border-left-color: var(--rl-error-text, #c60e36);
  }
  /* Language chip shared by rustlab cells and highlighted prose fences. */
  .rl-lang {
    font: 600 0.75rem/1.4 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    color: var(--rl-text-dim);
    padding: 0.1rem 0 0.35rem;
    user-select: none;
  }
  /* Source only. Open by default; collapsing leaves the summary, and
     the `.rl-cell` rule still marks output that follows. */
  .rl-src > summary {
    cursor: pointer;
    list-style: none;
  }
  .rl-src > summary::-webkit-details-marker { display: none; }
  .rl-src > summary::marker { content: ""; }
  .rl-src > summary::before {
    content: "▸";
    display: inline-block;
    width: 1.1em;
    color: var(--rl-accent);
  }
  .rl-src[open] > summary::before {
    content: "▾";
  }
  /* Prose fences (bash / python / toml / yaml / text). Same panel colors as a rustlab
     cell: `.source` for code, `.output` for uncolored text. The accent
     rule matches the PDF tcolorbox. */
  .rl-fence {
    margin: 0.35rem 0 1.1rem 0.15rem;
    padding-left: 0.85rem;
    border-left: 3px solid var(--rl-accent-primary, #7113ec);
  }
  .rl-fence .output {
    margin-top: 0;
  }
  .rl-fence code {
    background: transparent;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
  }
  .source {
    background: var(--rl-code-bg, #dce0e8);
    border: 1px solid var(--rl-border, #ccd0da);
    border-radius: 6px;
    padding: 1rem;
    overflow-x: auto;
    font-family: "SF Mono", "Fira Code", "JetBrains Mono", monospace;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--rl-text, #4c4f69);
  }
  .output {
    background: var(--rl-output-bg, #e6e9ef);
    border: 1px solid var(--rl-border, #ccd0da);
    border-radius: 6px;
    padding: 0.8rem 1rem;
    margin-top: 0.5rem;
    color: var(--rl-text-dim, #56586a);
    font-family: "SF Mono", "Fira Code", "JetBrains Mono", monospace;
    font-size: 0.85rem;
    white-space: pre-wrap;
    line-height: 1.5;
  }
  /* Table display. Header wash, zebra, and rules are a mix of the theme
     text color into the page background (11%, 6%, 30%). No extra stylesheet
     and no CDN. */
  table.rl-table {
    border-collapse: collapse;
    margin: 0.6rem 0 0.2rem;
    background: var(--rl-output-bg, #e6e9ef);
    color: var(--rl-text, #4c4f69);
    font-family: "SF Mono", "Fira Code", "JetBrains Mono", monospace;
    font-size: 0.85rem;
    border: 1px solid color-mix(in srgb, var(--rl-text, #4c4f69) 30%, var(--rl-bg, #eff1f5));
    border-radius: 6px;
    overflow: hidden;
  }
  table.rl-table th {
    text-align: left;
    font-weight: 600;
    color: var(--rl-accent-primary, #7113ec);
    background: color-mix(in srgb, var(--rl-text, #4c4f69) 11%, var(--rl-bg, #eff1f5));
    border-bottom: 1px solid color-mix(in srgb, var(--rl-text, #4c4f69) 30%, var(--rl-bg, #eff1f5));
    padding: 0.4rem 0.8rem;
  }
  table.rl-table td {
    padding: 0.3rem 0.8rem;
    border-bottom: 1px solid color-mix(in srgb, var(--rl-text, #4c4f69) 30%, var(--rl-bg, #eff1f5));
    color: var(--rl-text, #4c4f69);
  }
  table.rl-table td.rl-num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  table.rl-table tr:last-child td {
    border-bottom: none;
  }
  table.rl-table tbody tr:nth-child(even) td {
    background: color-mix(in srgb, var(--rl-text, #4c4f69) 6%, var(--rl-bg, #eff1f5));
  }
  .error {
    background: var(--rl-error-bg, #fce4e4);
    border: 1px solid var(--rl-error-text, #c60e36);
    border-radius: 6px;
    padding: 0.8rem 1rem;
    margin-top: 0.5rem;
    color: var(--rl-error-text, #c60e36);
    font-family: "SF Mono", "Fira Code", "JetBrains Mono", monospace;
    font-size: 0.85rem;
    white-space: pre-wrap;
  }
  .plot-container {
    background: var(--rl-bg, #eff1f5);
    border: 1px solid var(--rl-border, #ccd0da);
    border-radius: 8px;
    margin-top: 0.5rem;
    height: 450px;
  }
  .plot-container > div {
    width: 100%;
    height: 100%;
  }
  footer {
    color: var(--rl-footer-text, #686d82);
    font-size: 0.8rem;
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rl-border, #ccd0da);
  }
  .page-nav {
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
    margin-top: 2.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rl-border, #ccd0da);
  }
  .page-nav a {
    flex: 1 1 0;
    padding: 0.7rem 1rem;
    background: var(--rl-bg-secondary, #e6e9ef);
    border: 1px solid var(--rl-border, #ccd0da);
    border-radius: 8px;
    color: var(--rl-accent-secondary, #094dd3);
    text-decoration: none;
    font-size: 0.9rem;
    transition: background 0.15s, border-color 0.15s;
    min-width: 0;
  }
  .page-nav a:hover {
    background: var(--rl-border, #ccd0da);
    border-color: var(--rl-accent-secondary, #094dd3);
  }
  .page-nav .label {
    display: block;
    color: var(--rl-text-dim, #56586a);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.2rem;
  }
  .page-nav .title {
    display: block;
    color: var(--rl-text, #4c4f69);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .page-nav .prev { text-align: left; }
  .page-nav .index { text-align: center; align-self: center; }
  .page-nav .next { text-align: right; }
  /* ── Syntax highlighting ── */
  .syn-kw  { color: var(--rl-syn-keyword, #802cee); }
  .syn-fn  { color: var(--rl-syn-function, #0a55ea); }
  .syn-num { color: var(--rl-syn-number, #ad4001); }
  .syn-str { color: var(--rl-syn-string, #2d711e); }
  .syn-com { color: var(--rl-syn-comment, #5e6376); font-style: italic; }
  .syn-op  { color: var(--rl-syn-operator, #116e74); }
  /* ── Callout blocks ── */
  .callout {
    border-left: 4px solid;
    border-radius: 6px;
    padding: 1rem 1.2rem;
    margin: 1rem 0;
  }
  .callout-title {
    font-weight: 700;
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }
  .callout-note {
    border-color: var(--rl-accent-secondary, #094dd3);
    background: var(--rl-bg-secondary, #e6e9ef);
  }
  .callout-note .callout-title { color: var(--rl-accent-secondary, #094dd3); }
  .callout-tip {
    border-color: var(--rl-accent-tertiary, #12747a);
    background: var(--rl-bg-secondary, #e6e9ef);
  }
  .callout-tip .callout-title { color: var(--rl-accent-tertiary, #12747a); }
  .callout-important {
    border-color: var(--rl-accent-primary, #7113ec);
    background: var(--rl-bg-secondary, #e6e9ef);
  }
  .callout-important .callout-title { color: var(--rl-accent-primary, #7113ec); }
  .callout-warning {
    border-color: var(--rl-error-text, #c60e36);
    background: var(--rl-bg-secondary, #e6e9ef);
  }
  .callout-warning .callout-title { color: var(--rl-error-text, #c60e36); }
  .callout-caution {
    border-color: var(--rl-error-text, #c60e36);
    background: var(--rl-bg-secondary, #e6e9ef);
  }
  .callout-caution .callout-title { color: var(--rl-error-text, #c60e36); }
  /* ── Interactive widgets ── */
  .rl-widget {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0.75rem 0;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--rl-border, #ccd0da);
    border-radius: 6px;
    background: var(--rl-bg-secondary, #e6e9ef);
  }
  .rl-widget-label {
    font-weight: 600;
    font-size: 0.9rem;
    white-space: nowrap;
    color: var(--rl-text, #4c4f69);
  }
  .rl-widget-input {
    flex: 1;
    accent-color: var(--rl-accent-primary, #7113ec);
  }
  .rl-widget-value {
    font-variant-numeric: tabular-nums;
    min-width: 4ch;
    text-align: right;
    color: var(--rl-accent-primary, #7113ec);
  }
  .rl-widget-options {
    flex-wrap: wrap;
  }
  .rl-widget-choice {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .rl-widget input[type="number"] {
    flex: 0 0 auto;
    width: 7rem;
    padding: 0.2rem 0.4rem;
    border: 1px solid color-mix(in srgb, var(--rl-text-dim, #56586a) 75%, var(--rl-bg, #eff1f5));
    border-radius: 4px;
    background: var(--rl-bg, #eff1f5);
    color: var(--rl-text, #4c4f69);
  }
  .rl-widget input:disabled {
    opacity: 0.65;
    cursor: default;
  }
  .rl-widget-drives, .rl-widget-note, .rl-drive-note {
    margin: 0 0 0.75rem;
    padding: 0 0.9rem;
    font-size: 0.8rem;
    color: var(--rl-text-dim, #56586a);
  }
  .rl-widget-drives {
    margin-top: -0.35rem;
  }
  .rl-widget-drives a {
    color: var(--rl-accent-primary, #7113ec);
  }
  /* Control panel folded into the code section, left of the plot.
     Nested in column 1 so it does not fight the comments track. */
  .rl-drive {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    gap: 0.75rem;
    margin: 0.75rem 0;
    padding: 0.75rem;
    border: 1px solid var(--rl-border, #ccd0da);
    border-radius: 8px;
    background: var(--rl-bg-secondary, #e6e9ef);
    align-items: start;
  }
  .rl-drive-solo {
    grid-template-columns: minmax(0, 1fr);
  }
  .rl-drive-controls {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }
  .rl-drive .rl-widget {
    flex-direction: column;
    align-items: stretch;
    margin: 0;
    padding: 0.15rem 0;
    border: none;
    background: transparent;
    gap: 0.35rem;
  }
  .rl-drive .rl-widget-label {
    white-space: normal;
  }
  .rl-drive .rl-widget-input[type="range"] {
    width: 100%;
  }
  .rl-drive-plot {
    min-width: 0;
  }
  .rl-drive-plot .plot-container {
    margin-top: 0;
  }
  .rl-drive-note {
    margin: 0.35rem 0 0;
    padding: 0;
  }
  @keyframes rl-plot-flash {
    0% { outline: 2px solid var(--rl-accent-primary, #7113ec); outline-offset: 2px; }
    100% { outline-color: transparent; }
  }
  .rl-plot-flash {
    animation: rl-plot-flash 700ms ease-out 1;
  }
  @media (max-width: 799px) {
    .rl-drive {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* ── Exercise / solution blocks ── */
  .exercise {
    border: 1px solid var(--rl-border, #ccd0da);
    border-radius: 8px;
    padding: 1.2rem;
    margin: 1.5rem 0;
    background: var(--rl-bg-secondary, #e6e9ef);
  }
  .exercise-title {
    font-weight: 700;
    color: var(--rl-accent-primary, #7113ec);
    margin-bottom: 0.8rem;
    font-size: 1.05rem;
  }
  .solution {
    margin-top: 1rem;
  }
  .solution > summary {
    cursor: pointer;
    color: var(--rl-accent-secondary, #094dd3);
    font-weight: 600;
    padding: 0.3rem 0;
  }
  /* ── Collapsible code output ── */
  .code-details > summary {
    cursor: pointer;
    color: var(--rl-accent-secondary, #094dd3);
    font-weight: 600;
    padding: 0.4rem 0;
  }
  /* ── Image grid ── */
  .image-grid {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  /* ── Responsive: collapse sidebar on narrow screens ── */
  @media (max-width: 768px) {
    nav.sidebar {
      transform: translateX(-100%);
    }
    nav.sidebar.open {
      transform: translateX(0);
    }
    .nav-toggle {
      display: block;
    }
    main {
      margin-left: 0;
      padding: calc(var(--topbar-h) + 1rem) 1rem 2rem;
    }
    /* Leave room for the hamburger, which sits over the topbar's left
       end. no-toc pages have no hamburger — don't reserve 3rem of the
       narrowest layout for a button that doesn't exist. */
    body:not(.no-toc) .topbar {
      padding-left: 3rem;
    }
    /* The file browser overlays on a narrow screen (`--fb-w: 0` in its
       own stylesheet) instead of reserving a second column beside the
       off-canvas TOC. */
    body.has-files main,
    body.has-files.no-toc main {
      margin-left: 0;
      padding: calc(var(--topbar-h) + 1rem) 1rem 2rem;
    }
    .topbar a.prev, .topbar a.next {
      max-width: 28%;
    }
  }

.rl-cm-mark {
  background: var(--rl-cm-mark-bg, #554f4e);
  color: var(--rl-text, inherit);
  border-bottom: 1px solid var(--rl-cm-note-border, var(--rl-accent-secondary));
  padding: 0 0.05em;
}
.rl-cm-ref {
  font-size: 0.72rem;
  font-weight: 700;
  line-height: 1;
  color: var(--rl-accent-primary);
  margin-left: 0.12em;
  cursor: pointer;
}
.rl-cm-ref::before { content: "["; }
.rl-cm-ref::after { content: "]"; }
.rl-cm-ref-block { float: right; margin: 0 0 0.2rem 0.4rem; }
.rl-cm-cellmark { display: flex; justify-content: flex-end; }
p:has(> .rl-cm-ref-block:only-child) { margin: 0.2rem 0; }
/* Right margin column inside each section. The prose shrinks so the
   column stays, including a directory page (`body.has-files`) with the
   file browser and the TOC. Cards are never in the paragraph. With
   scripting off they stack in this column in document order. 14rem is
   the default; a reader drag writes an inline width on `body`. */
body.has-cm-margin { --rl-cm-col: 14rem; }
body.has-cm-margin section.rl-block {
  display: grid;
  grid-template-columns: minmax(0, 1fr) var(--rl-cm-col, 14rem);
  column-gap: 1rem;
  align-items: start;
}
body.has-cm-margin section.rl-block > .rl-cm-margin {
  grid-column: 2;
  grid-row: 1 / -1;
  position: relative;
  min-width: 0;
  overflow: visible;
}
body.has-cm-margin section.rl-block > :not(.rl-cm-margin) {
  grid-column: 1;
  min-width: 0;
}
.rl-cm-margin-label {
  display: block;
  margin: 0 0 0.4rem;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--rl-text-dim, var(--rl-text));
}
.rl-cm-card, .rl-cm-note, .rl-cm-blocknote {
  background: var(--rl-cm-note-bg, var(--rl-bg-secondary));
  color: var(--rl-text);
  border: 1px solid var(--rl-cm-note-border, var(--rl-accent-secondary));
  border-radius: 6px;
  font-size: 0.85rem;
  line-height: 1.35;
  display: block;
  margin: 0 0 0.55rem;
  padding: 0.4rem 0.55rem 0.45rem;
}
.rl-cm-head { display: flex; flex-wrap: wrap; gap: 0.35rem; align-items: baseline; margin-bottom: 0.2rem; }
.rl-cm-num { font-weight: 700; color: var(--rl-cm-note-border, var(--rl-accent-secondary)); }
.rl-cm-meta { opacity: 0.85; }
.rl-cm-text { display: block; }
.rl-cm-fold { display: block; }
.rl-cm-card.rl-cm-clamped:not(.rl-cm-open) .rl-cm-fold {
  max-height: calc(1.35em * 6);
  overflow: hidden;
}
.rl-cm-more {
  display: inline-block;
  margin-top: 0.2rem;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--rl-accent-primary);
  font: inherit;
  font-size: 0.75rem;
  font-weight: 700;
  cursor: pointer;
}
.rl-cm-more[hidden] { display: none; }
.rl-cm-link {
  position: absolute;
  left: -0.7rem;
  width: 0.7rem;
  border-left: 1px solid var(--rl-cm-note-border, var(--rl-accent-secondary));
  border-bottom: 1px solid var(--rl-cm-note-border, var(--rl-accent-secondary));
  opacity: 0.55;
  pointer-events: none;
}
.rl-cm-link[hidden] { display: none; }
.rl-cm-card.rl-cm-drift .rl-cm-num { font-size: 1rem; }
.rl-cm-reply {
  display: block;
  margin: 0.35rem 0 0.15rem 0.75rem;
  padding-left: 0.45rem;
  border-left: 2px solid var(--rl-cm-note-border, var(--rl-accent-secondary));
}
.rl-cm-actions {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 0.25rem;
  margin-top: 0.35rem;
}
.rl-cm-mark.rl-cm-hot, .rl-cm-ref.rl-cm-hot {
  outline: 2px solid var(--rl-accent-primary);
  outline-offset: 1px;
}
.rl-cm-card.rl-cm-hot {
  border-color: var(--rl-accent-primary);
  box-shadow: -3px 0 0 var(--rl-accent-primary);
}
.rl-cm-warn { cursor: help; }
.rl-comments-toggle { margin-left: 0.8rem; font-size: 0.85rem; white-space: nowrap; }
.rl-cm-confirm { margin-left: 0.6rem; font-size: 0.8rem; }
/* `!important` beats a dragged inline width on body. The collapsed
   strip is only the wide layout, and it is declared first so this
   rule still wins when Comments is unchecked. */
@media (min-width: 800px) {
  body.has-cm-margin.rl-cm-collapsed { --rl-cm-col: 2.5rem !important; }
  body.has-cm-margin.rl-cm-collapsed .rl-cm-fold,
  body.has-cm-margin.rl-cm-collapsed .rl-cm-meta,
  body.has-cm-margin.rl-cm-collapsed .rl-cm-actions,
  body.has-cm-margin.rl-cm-collapsed .rl-cm-more,
  body.has-cm-margin.rl-cm-collapsed .rl-cm-link,
  body.has-cm-margin.rl-cm-collapsed .rl-cm-margin-label,
  body.has-cm-margin.rl-cm-collapsed .rl-cm-reply { display: none; }
  body.has-cm-margin.rl-cm-collapsed .rl-cm-card {
    padding: 0.2rem 0.15rem;
    text-align: center;
  }
}
body:has(#rl-comments:not(:checked)) { --rl-cm-col: 0px !important; }
body:has(#rl-comments:not(:checked)) #rl-cm-sizer { display: none !important; }
body:has(#rl-comments:not(:checked)) section.rl-block { column-gap: 0; }
body:has(#rl-comments:not(:checked)) .rl-cm-margin,
body:has(#rl-comments:not(:checked)) .rl-cm-ref,
body:has(#rl-comments:not(:checked)) .rl-cm-cellmark { display: none; }
body:has(#rl-comments:not(:checked)) .rl-cm-mark {
  background: transparent;
  border-bottom-color: transparent;
  color: inherit;
}
@media (min-width: 800px) {
  .rl-cm-margin-label { pointer-events: none; list-style: none; }
  .rl-cm-margin-label::-webkit-details-marker { display: none; }
  .rl-cm-margin-label::marker { content: ""; }
  section.rl-block:has(.rl-cm-margin) ~ section.rl-block .rl-cm-margin-label { display: none; }
}
#rl-cm-menu, #rl-cm-pop {
  position: fixed;
  /* Above the TOC sidebar (100), the file browser (120, or 180 when the
     narrow browser is open), the watch contents drawer (240), and the
     top bar (150). The edit toolbar stays higher. */
  z-index: 400;
  background: var(--rl-cm-note-bg, var(--rl-bg-secondary));
  color: var(--rl-text);
  border: 1px solid var(--rl-cm-note-border, var(--rl-accent-secondary));
  border-radius: 6px;
  padding: 0.25rem;
}
#rl-cm-menu button {
  display: block;
  width: 100%;
  text-align: left;
  background: transparent;
  color: var(--rl-text);
  border: 2px solid transparent;
  border-radius: 4px;
  padding: 0.25rem 0.5rem;
  font: inherit;
  cursor: pointer;
}
/* Composer. Name on top, comment full width, actions in one row at
   the right. Tokens are the theme roles, so mocha and latte both
   keep 4.5:1 (accent fill with the page background as the label). */
#rl-cm-pop {
  width: min(20rem, calc(100vw - 16px));
  padding: 0.65rem 0.7rem 0.6rem;
  box-shadow: 0 10px 28px color-mix(in srgb, var(--rl-shadow-color, #000000) 35%, transparent);
}
#rl-cm-pop-ctx { margin: 0 0 0.45rem; font-size: 0.8rem; }
#rl-cm-pop-ctx:empty { display: none; }
#rl-cm-pop label {
  display: block;
  margin: 0 0 0.45rem;
  font-size: 0.75rem;
  color: var(--rl-text);
}
#rl-cm-pop input, #rl-cm-pop textarea {
  display: block;
  width: 100%;
  box-sizing: border-box;
  margin-top: 0.2rem;
  padding: 0.35rem 0.45rem;
  font: inherit;
  font-size: 0.85rem;
  color: var(--rl-text);
  background: var(--rl-bg, var(--rl-bg-secondary));
  border: 1px solid var(--rl-cm-note-border, var(--rl-accent-secondary));
  border-radius: 4px;
}
#rl-cm-pop textarea {
  min-height: 4.5rem;
  resize: vertical;
  margin: 0 0 0.55rem;
}
.rl-cm-pop-actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 0.35rem;
}
#rl-cm-pop .rl-cm-pop-actions button {
  display: inline-block;
  width: auto;
  text-align: center;
  font: inherit;
  font-size: 0.78rem;
  cursor: pointer;
  color: var(--rl-text);
  background: transparent;
  border: 1px solid var(--rl-cm-note-border, var(--rl-accent-secondary));
  border-radius: 4px;
  padding: 0.28rem 0.55rem;
}
#rl-cm-pop #rl-cm-go {
  color: var(--rl-bg);
  background: var(--rl-accent-primary);
  border-color: var(--rl-accent-primary);
  font-weight: 600;
}
/* `display` on the buttons above beats the user-agent `[hidden]` rule.
   This selector is at least as specific and comes later. */
#rl-cm-menu button[hidden], #rl-cm-pop button[hidden] { display: none; }
.rl-cm-actions button {
  display: inline-block;
  width: auto;
  text-align: center;
  background: transparent;
  color: var(--rl-text);
  border: 1px solid var(--rl-cm-note-border, var(--rl-accent-secondary));
  border-radius: 4px;
  font-size: 0.75rem;
  line-height: 1.2;
  padding: 0.1rem 0.4rem;
}
#rl-cm-menu button:hover, #rl-cm-menu button:focus,
#rl-cm-pop button:hover, #rl-cm-pop button:focus,
.rl-cm-actions button:hover, .rl-cm-actions button:focus {
  border-color: var(--rl-cm-note-border, var(--rl-accent-secondary));
  outline: none;
}
@media (pointer: coarse) {
  #rl-cm-menu button, #rl-cm-pop button { padding: 0.55rem 0.7rem; }
  .rl-cm-actions button { padding: 0.3rem 0.5rem; }
}
/* Drag handle on the column's left edge, in the 1rem gap, so it does
   not cover the prose or a widget in column 1. The box is fixed; the
   script parks it on the aside. */
#rl-cm-sizer {
  position: fixed;
  top: var(--topbar-h, 2.6rem);
  bottom: 0;
  width: 12px;
  z-index: 160;
  pointer-events: none;
}
#rl-cm-sizer[hidden] { display: none; }
#rl-cm-collapse, #rl-cm-resize { pointer-events: auto; }
#rl-cm-collapse {
  position: absolute;
  top: 0.35rem;
  left: 0;
  width: 1.25rem;
  height: 1.25rem;
  margin: 0;
  padding: 0;
  border: 1px solid var(--rl-cm-note-border, var(--rl-accent-secondary));
  border-radius: 4px;
  background: var(--rl-cm-note-bg, var(--rl-bg-secondary));
  color: var(--rl-text);
  font: inherit;
  font-size: 0.9rem;
  line-height: 1;
  cursor: pointer;
}
#rl-cm-collapse:focus-visible {
  outline: 2px solid var(--rl-accent-primary);
  outline-offset: 1px;
}
#rl-cm-resize {
  position: absolute;
  top: 1.9rem;
  bottom: 0;
  left: 0;
  width: 12px;
  cursor: col-resize;
  touch-action: none;
}
#rl-cm-resize::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: 5px;
  width: 2px;
  background: var(--rl-cm-note-border, var(--rl-accent-secondary));
}
#rl-cm-resize:hover::after, #rl-cm-resize:focus-visible::after {
  background: var(--rl-accent-primary);
}
#rl-cm-resize:focus-visible { outline: none; }
/* A side column does not fit. Cards drop to a drawer at the bottom of
   the section. They stay out of the paragraph. `!important` drops a
   dragged width. The collapsed strip does not apply here. */
@media (max-width: 799px) {
  body.has-cm-margin { --rl-cm-col: 0px !important; }
  #rl-cm-sizer { display: none !important; }
  body.has-cm-margin section.rl-block { column-gap: 0; }
  body.has-cm-margin section.rl-block > .rl-cm-margin {
    grid-column: 1;
    grid-row: auto;
    margin-top: 0.75rem;
  }
  .rl-cm-margin-label { pointer-events: auto; cursor: pointer; }
  section.rl-block:has(.rl-cm-margin) ~ section.rl-block .rl-cm-margin-label { display: block; }
}
.rl-cm-undo {
  position: fixed; right: 16px; bottom: 16px; z-index: 450;
  background: var(--rl-bg-secondary, #313244); color: var(--rl-text, #cdd6f4);
  border: 1px solid var(--rl-border, #45475a); border-radius: 8px;
  padding: 8px 12px; font: 13px/1.3 -apple-system, system-ui, sans-serif;
  box-shadow: 0 8px 24px rgba(0,0,0,.25);
}
.rl-cm-undo button { margin-left: 8px; }
.rl-cm-undo[hidden] { display: none; }
@media print {
  .rl-cm-card { position: static !important; top: auto !important; left: auto !important; right: auto !important; width: auto !important; }
  .rl-cm-card.rl-cm-clamped .rl-cm-fold { max-height: none; overflow: visible; }
  .rl-comments-toggle, #rl-cm-menu, #rl-cm-pop, .rl-cm-confirm, .rl-cm-actions, .rl-cm-undo, .rl-cm-more, .rl-cm-link, #rl-cm-sizer { display: none !important; }
}

</style>
<style>
  :root {
    --rl-shadow-color: #000000;
    --rl-scrim: #11111b;
    --rl-banner-bg: #aa2233;
    --rl-banner-text: #ffffff;
  }
  #rl-toolbar {
    position: fixed; top: 10px; right: 14px; z-index: 100000;
    display: flex; gap: 6px; align-items: center;
  }
  /* Every served page carries the topbar; reserve room on its right so the
     "Next" link and title don't slide under the fixed toolbar. This used to
     be scoped to `body.topbar-layout`, which no longer exists — leaving the
     toolbar sitting on top of the next-notebook link, unclickable. */
  .topbar { padding-right: 9rem; }
  #rl-toolbar { flex-wrap: wrap; justify-content: flex-end; max-width: min(70vw, 40rem); }
  #rl-toolbar button {
    font: 12px/1 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    background: var(--rl-bg-secondary, #e6e9ef); color: var(--rl-text, #4c4f69);
    border: 1px solid var(--rl-border, #ccd0da); border-radius: 6px;
    padding: 6px 11px; cursor: pointer;
  }
  #rl-toolbar button:hover { border-color: var(--rl-accent-primary, #7113ec); }
  #rl-toolbar button.active { background: var(--rl-accent-primary, #7113ec); color: var(--rl-bg, #eff1f5); border-color: var(--rl-accent-primary, #7113ec); }
  #rl-toolbar button[hidden] { display: none; }
  #rl-toolbar button.rl-quiet { opacity: 0.85; padding: 4px 8px; }
  .rl-more { position: relative; display: inline-flex; align-items: center; }
  #rl-more-btn { min-width: 2rem; letter-spacing: 0.08em; }
  .rl-diff-dot {
    position: absolute; top: -1px; right: -1px; width: 7px; height: 7px;
    border-radius: 50%; background: var(--rl-dx-mod-bar, var(--rl-accent-primary, #7113ec)); pointer-events: none;
  }
  .rl-more-panel {
    position: absolute; top: calc(100% + 6px); right: 0; z-index: 100002;
    display: flex; flex-direction: column; gap: 8px; align-items: stretch;
    min-width: 16rem; padding: 8px;
    background: var(--rl-bg-secondary, #e6e9ef); color: var(--rl-text, #4c4f69);
    border: 1px solid var(--rl-border, #ccd0da); border-radius: 8px;
    box-shadow: 0 8px 24px color-mix(in srgb, var(--rl-shadow-color, #000000) 28%, transparent);
  }
  #rl-toolbar #rl-diff-toggle {
    display: flex; align-items: center; gap: 8px; width: 100%; text-align: left;
    background: transparent; color: var(--rl-text, #4c4f69);
  }
  #rl-toolbar #rl-diff-toggle.active { background: transparent; color: var(--rl-text, #4c4f69); border-color: var(--rl-border, #ccd0da); }
  .rl-switch {
    width: 28px; height: 16px; border-radius: 99px; flex: none; position: relative;
    border: 1px solid var(--rl-border, #ccd0da); background: var(--rl-bg, #eff1f5);
  }
  .rl-switch::after {
    content: ""; position: absolute; top: 1px; left: 1px;
    width: 12px; height: 12px; border-radius: 50%; background: var(--rl-text, #4c4f69);
  }
  #rl-diff-toggle[aria-checked="true"] .rl-switch { background: var(--rl-accent-primary, #7113ec); border-color: var(--rl-accent-primary, #7113ec); }
  #rl-diff-toggle[aria-checked="true"] .rl-switch::after { left: 13px; background: var(--rl-bg, #eff1f5); }
  #rl-toolbar #rl-diff-toggle:disabled { opacity: 0.45; cursor: not-allowed; }
  /* In-panel switches stay full contrast. A disabled Show changes stays dim,
     and the ⋯ button keeps .rl-quiet. */
  #rl-toolbar #rl-more-panel .rl-quiet:not(:disabled),
  #rl-toolbar .rl-menu-switch { opacity: 1; }
  #rl-toolbar .rl-menu-switch {
    position: relative;
    display: flex; align-items: center; gap: 8px; width: 100%;
    box-sizing: border-box; text-align: left;
    font: 12px/1 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    background: transparent; color: var(--rl-text, #4c4f69);
    border: 1px solid transparent; border-radius: 6px;
    padding: 6px 8px; cursor: pointer;
  }
  #rl-toolbar .rl-menu-switch input {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
  #rl-comments:checked + .rl-switch { background: var(--rl-accent-primary, #7113ec); border-color: var(--rl-accent-primary, #7113ec); }
  #rl-comments:checked + .rl-switch::after { left: 13px; background: var(--rl-bg, #eff1f5); }
  #rl-comments:focus-visible + .rl-switch {
    outline: 2px solid var(--rl-accent-primary, #7113ec); outline-offset: 2px;
  }
  #rl-cm-confirm:empty { display: none !important; }
  #rl-cm-confirm:not(:empty) {
    position: fixed; top: 46px; right: 14px; z-index: 100001; margin: 0;
    padding: 4px 8px; max-width: 22rem;
    background: var(--rl-bg-secondary, #e6e9ef); color: var(--rl-text, #4c4f69);
    border: 1px solid var(--rl-border, #ccd0da); border-radius: 6px;
    font: 12px/1.35 system-ui, sans-serif;
  }
  p.rl-git-note { margin: 0; font: 11px/1.35 system-ui, sans-serif; color: var(--rl-text-dim, #56586a); }
  body.rl-diff-on .rl-more-panel { width: 22rem; max-height: calc(100vh - 64px); overflow: auto; }
  #rl-diff { display: flex; flex-direction: column; gap: 4px; align-items: stretch; }
  #rl-diff[hidden], #rl-diff-banner[hidden], .rl-diff-menu[hidden], #rl-dx-other[hidden],
  .rl-dx-opt[hidden], .rl-more-panel[hidden], #rl-diff-dot[hidden] { display: none !important; }
  .rl-dx-hd {
    margin: 8px 0 2px; font: 600 11px/1.2 system-ui, sans-serif; color: var(--rl-text-dim, #56586a);
    text-transform: uppercase; letter-spacing: 0.06em;
  }
  #rl-toolbar .rl-dx-opt {
    display: grid; grid-template-columns: 14px 1fr auto; gap: 2px 8px; align-items: start;
    width: 100%; text-align: left; padding: 6px 8px; border-radius: 6px;
    background: transparent; color: var(--rl-text, #4c4f69); border: 1px solid transparent;
    font: 13px/1.35 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
  }
  #rl-toolbar .rl-dx-opt:hover { border-color: var(--rl-border, #ccd0da); }
  #rl-toolbar .rl-dx-opt[aria-checked="true"] { border-color: var(--rl-accent-primary, #7113ec); }
  #rl-toolbar .rl-dx-opt:disabled { opacity: 0.55; cursor: not-allowed; }
  .rl-dx-dot {
    width: 10px; height: 10px; margin-top: 3px; border-radius: 50%;
    border: 1.5px solid var(--rl-text-dim, #56586a); box-sizing: border-box;
  }
  .rl-dx-opt[aria-checked="true"] .rl-dx-dot { border-color: var(--rl-accent-primary, #7113ec); background: var(--rl-accent-primary, #7113ec); box-shadow: inset 0 0 0 2px var(--rl-bg-secondary, #e6e9ef); }
  .rl-dx-t { font-weight: 600; }
  .rl-dx-c { color: var(--rl-text-dim, #56586a); font-size: 12px; white-space: nowrap; }
  .rl-dx-d { grid-column: 2 / 4; color: var(--rl-text-dim, #56586a); font-size: 12px; }
  #rl-dx-other { display: flex; flex-direction: column; gap: 4px; margin: 2px 0 4px 22px; }
  #rl-diff input {
    font: 12px/1.2 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    background: var(--rl-bg, #eff1f5); color: var(--rl-text, #4c4f69);
    border: 1px solid color-mix(in srgb, var(--rl-text-dim, #56586a) 75%, var(--rl-bg, #eff1f5)); border-radius: 6px;
    padding: 4px 6px; width: 100%; box-sizing: border-box;
  }
  #rl-diff input:focus { border-color: var(--rl-accent-primary, #7113ec); outline: none; }
  .rl-diff-lab { font: 12px/1 system-ui, sans-serif; color: var(--rl-text-dim, #56586a); display: flex; gap: 6px; align-items: center; }
  .rl-dx-lab { width: 3.8rem; flex: none; }
  .rl-diff-combo { position: relative; display: flex; flex: 1; min-width: 0; }
  .rl-dx-arrow, .rl-dx-hint, .rl-dx-keys { margin: 0; font: 11px/1.35 system-ui, sans-serif; color: var(--rl-text-dim, #56586a); }
  .rl-dx-arrow { text-align: center; }
  .rl-diff-menu {
    margin: 0; padding: 2px; list-style: none;
    max-height: 14rem; overflow: auto;
    background: var(--rl-bg, #eff1f5); color: var(--rl-text, #4c4f69);
    border: 1px solid var(--rl-border, #ccd0da); border-radius: 6px;
    font: 12px/1.35 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
  }
  .rl-diff-menu li { padding: 3px 6px; border-radius: 4px; cursor: pointer; display: flex; justify-content: space-between; gap: 10px; }
  .rl-diff-menu li span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rl-diff-menu li .rl-m { color: var(--rl-text-dim, #56586a); flex: none; }
  .rl-diff-menu li[aria-selected="true"] { background: var(--rl-accent-primary, #7113ec); color: var(--rl-bg, #eff1f5); }
  .rl-diff-menu li[aria-selected="true"] .rl-m { color: var(--rl-bg, #eff1f5); }
  .rl-diff-menu li.rl-diff-hint { color: var(--rl-text-dim, #56586a); cursor: default; }
  .rl-diff-menu li.rl-dx-group {
    cursor: default; padding-top: 6px; color: var(--rl-text-dim, #56586a);
    font: 600 10px/1.2 system-ui, sans-serif; text-transform: uppercase; letter-spacing: 0.05em;
  }
  #rl-dx-list { list-style: none; margin: 0; padding: 0; font: 12px/1.35 system-ui, sans-serif; }
  #rl-dx-list li {
    display: grid; grid-template-columns: 4px 5.2rem 1fr; gap: 8px; align-items: center;
    padding: 3px 6px; border-radius: 5px; cursor: pointer;
  }
  #rl-dx-list li:hover, #rl-dx-list li.rl-cur { background: var(--rl-bg, #eff1f5); }
  #rl-dx-list li:focus-visible { outline: 2px solid var(--rl-accent-primary, #7113ec); outline-offset: -2px; }
  #rl-dx-list li i { display: block; width: 4px; height: 14px; border-radius: 2px; }
  #rl-dx-list li .rl-k { color: var(--rl-text-dim, #56586a); }
  #rl-dx-list li.rl-empty { display: block; color: var(--rl-text-dim, #56586a); cursor: default; }
  .rl-dx-keys kbd {
    font: 11px ui-monospace, monospace; border: 1px solid var(--rl-border, #ccd0da); border-radius: 3px; padding: 0 4px;
  }
  #rl-diff-banner {
    position: fixed; top: 46px; right: 14px; z-index: 99999; margin: 0;
    padding: 6px 10px; max-width: 30rem; text-align: left; cursor: pointer;
    background: var(--rl-bg-secondary, #e6e9ef); color: var(--rl-text, #4c4f69);
    border: 1px solid var(--rl-border, #ccd0da); border-radius: 8px;
    font: 12px/1.35 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
  }
  #rl-diff-banner:hover { border-color: var(--rl-accent-primary, #7113ec); }
  #rl-diff-banner .rl-k { color: var(--rl-text-dim, #56586a); }
  #rl-diff-banner .rl-n { color: var(--rl-dx-mod-bar, var(--rl-accent-primary, #7113ec)); font-weight: 600; }
  .rl-diff-notice {
    margin: 0 0 1rem; padding: 0.6rem 0.85rem;
    background: var(--rl-bg-secondary, #e6e9ef); color: var(--rl-text, #4c4f69);
    border: 1px solid var(--rl-border, #ccd0da); border-left: 4px solid var(--rl-accent-primary, #7113ec);
    border-radius: 6px;
    font: 14px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
  }
  /* Changes are a bar in the gutter left of the text. No wash, so body
     text keeps its own colors. A code cell's accent rule is on its left
     edge, so the bar sits a gutter further out. */
  main .rl-dx { position: relative; }
  main .rl-dx::before {
    content: ""; position: absolute; left: -16px; top: 2px; bottom: 2px;
    width: 4px; border-radius: 2px; pointer-events: none;
  }
  main section.rl-dx::before { left: -22px; }
  main .rl-dx-add::before { background: var(--rl-dx-add-bar); }
  main .rl-dx-mod::before { background: var(--rl-dx-mod-bar); }
  main .rl-dx-del::before { background: var(--rl-dx-del-bar); }
  main details.rl-dx-removed { margin: 0.6rem 0; }
  main details.rl-dx-removed > summary {
    cursor: pointer; list-style: none; color: var(--rl-text-dim, #56586a);
    font: 13px/1.4 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
  }
  main details.rl-dx-removed > summary::-webkit-details-marker { display: none; }
  main details.rl-dx-removed > summary::before { content: "▸ "; color: var(--rl-dx-del-bar); }
  main details.rl-dx-removed[open] > summary::before { content: "▾ "; }
  main details.rl-dx-removed > summary b { color: var(--rl-text, #4c4f69); font-weight: 600; }
  main .rl-dx-gone {
    text-decoration: line-through; text-decoration-color: var(--rl-dx-del-bar);
  }
  main .rl-dx-gone pre { text-decoration: inherit; }
  .rl-dx-note { margin: 4px 0 0; font: 12px/1.3 -apple-system, system-ui, sans-serif; color: var(--rl-text-dim, #56586a); }
  main pre.rl-dx-code code { display: block; }
  main pre.rl-dx-code .rl-ln { display: block; white-space: pre-wrap; padding-right: 0.6em; }
  main pre.rl-dx-code .rl-ln-g {
    display: inline-block; width: 1.8em; text-align: center; color: var(--rl-text-dim, #56586a); user-select: none;
  }
  main pre.rl-dx-code .rl-ln-add { background: var(--rl-dx-add-line); box-shadow: inset 2px 0 0 var(--rl-dx-add-bar); }
  main pre.rl-dx-code .rl-ln-del { background: var(--rl-dx-del-line); box-shadow: inset 2px 0 0 var(--rl-dx-del-bar); }
  main pre.rl-dx-code .rl-ln-add .rl-ln-g { color: var(--rl-dx-add-bar); }
  main pre.rl-dx-code .rl-ln-del .rl-ln-g { color: var(--rl-dx-del-bar); }
  main pre.rl-dx-code .rl-ln-del { text-decoration: line-through; text-decoration-color: var(--rl-dx-del-bar); }
  main details.rl-dx-src > summary { cursor: pointer; color: var(--rl-text-dim, #56586a); font: 12px/1.3 system-ui, sans-serif; }
  /* Word marks. Prose words get a tint that keeps body text at 4.5:1, and
     take the body text color so a link inside stays readable. Headings
     and code keep their own colors and get a 2px line instead. */
  main ins.rl-w, main del.rl-w {
    color: var(--rl-text, #4c4f69); border-radius: 3px; padding: 0 1px;
    -webkit-box-decoration-break: clone; box-decoration-break: clone;
  }
  main ins.rl-w { background: var(--rl-dx-add-word); text-decoration: none; }
  main del.rl-w {
    background: var(--rl-dx-del-word);
    text-decoration: line-through; text-decoration-color: var(--rl-dx-del-bar);
  }
  main ins.rl-w a, main del.rl-w a { color: inherit; }
  main ins.rl-w-all { padding: 1px 2px; }
  main :is(h1, h2, h3, h4, h5, h6) :is(ins, del).rl-w,
  main pre.rl-dx-code :is(ins, del).rl-w,
  main .rl-dx-srcview :is(ins, del).rl-w {
    background: none; color: inherit; padding: 0; border-radius: 0;
    text-decoration-thickness: 2px; text-underline-offset: 3px;
  }
  main :is(h1, h2, h3, h4, h5, h6) ins.rl-w,
  main pre.rl-dx-code ins.rl-w,
  main .rl-dx-srcview ins.rl-w {
    text-decoration-line: underline; text-decoration-color: var(--rl-dx-add-bar);
  }
  main :is(h1, h2, h3, h4, h5, h6) del.rl-w {
    text-decoration-line: line-through; text-decoration-color: var(--rl-dx-del-bar);
  }
  main pre.rl-dx-code del.rl-w, main .rl-dx-srcview del.rl-w {
    text-decoration-line: underline line-through; text-decoration-color: var(--rl-dx-del-bar);
  }
  /* Source view: the unified diff of the .md. */
  main .rl-dx-srcview {
    margin: 3rem 0 1rem; overflow: hidden;
    background: var(--rl-code-bg, var(--rl-code-bg, #dce0e8)); color: var(--rl-text, #4c4f69);
    border: 1px solid var(--rl-border, #ccd0da); border-radius: 8px;
    font: 13px/1.55 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  main .rl-dx-srcview .rl-dx::before { display: none; }
  main .rl-dx-fh {
    padding: 8px 12px; border-bottom: 1px solid var(--rl-border, #ccd0da); background: var(--rl-bg-secondary, #e6e9ef); color: var(--rl-text-dim, #56586a);
    font: 13px/1.35 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
  }
  main .rl-dx-hunk { padding: 3px 12px; background: var(--rl-bg-secondary, #e6e9ef); color: var(--rl-text-dim, #56586a); font-size: 12px; }
  main .rl-dx-l { display: grid; grid-template-columns: 3.4em 3.4em 1.8em 1fr; }
  main .rl-dx-n { color: var(--rl-text-dim, #56586a); text-align: right; padding-right: 6px; user-select: none; }
  main .rl-dx-s { text-align: center; color: var(--rl-text-dim, #56586a); user-select: none; }
  main .rl-dx-x { white-space: pre-wrap; word-break: break-word; padding-right: 12px; }
  main .rl-dx-l-add { background: var(--rl-dx-add-line); box-shadow: inset 2px 0 0 var(--rl-dx-add-bar); }
  main .rl-dx-l-del { background: var(--rl-dx-del-line); box-shadow: inset 2px 0 0 var(--rl-dx-del-bar); }
  main .rl-dx-l-add .rl-dx-s { color: var(--rl-dx-add-bar); }
  main .rl-dx-l-del .rl-dx-s { color: var(--rl-dx-del-bar); }
  main .rl-dx-none { padding: 8px 12px; }
  .rl-dx-seg { display: inline-flex; align-self: flex-start; border: 1px solid var(--rl-border, #ccd0da); border-radius: 6px; overflow: hidden; }
  #rl-toolbar .rl-dx-seg button {
    border: 0; border-radius: 0; background: transparent; color: var(--rl-text, #4c4f69); padding: 4px 12px;
  }
  #rl-toolbar .rl-dx-seg button[aria-checked="true"] { background: var(--rl-accent-primary, #7113ec); color: var(--rl-bg, #eff1f5); font-weight: 600; }
  .fb-git {
    display: inline-block; width: 7px; height: 7px; border-radius: 50%;
    margin-left: 6px; background: var(--rl-dx-mod-bar, currentColor); vertical-align: middle;
  }
  body { --rl-pane-w: min(760px, max(360px, 42vw)); }
  /* A comment column needs the pane narrower, or the fixed pane paints
     over the margin. The column starts at 14rem and can be dragged;
     the pane gives up width. */
  body.has-cm-margin { --rl-pane-w: min(560px, max(280px, 32vw)); }
  #rl-source-pane {
    position: fixed; top: 0; right: 0; height: 100vh;
    width: var(--rl-pane-w); min-width: 0; max-width: var(--rl-pane-w);
    background: var(--rl-code-bg, #dce0e8); border-left: 1px solid var(--rl-border, #ccd0da);
    z-index: 99998; display: flex; flex-direction: column;
    transform: translateX(101%); transition: transform .18s ease;
    box-shadow: -8px 0 24px color-mix(in srgb, var(--rl-shadow-color, #000000) 25%, transparent);
  }
  body.rl-source-open #rl-source-pane { transform: translateX(0); }
  /* With the pane open, main's viewport-centring margin (50% of the FULL
     width) would ignore the pane and squeeze the content against it —
     pin the margin to the pane width instead. */
  body.rl-source-open main { margin-left: 220px; margin-right: var(--rl-pane-w); max-width: none; }
  body.no-toc.rl-source-open main { margin-left: 0; }
  body.has-files.rl-source-open main { margin-left: calc(220px + var(--fb-w, 16.5rem)); }
  body.has-files.no-toc.rl-source-open main { margin-left: var(--fb-w, 16.5rem); }
  #rl-source-head {
    padding: 9px 14px; border-bottom: 1px solid var(--rl-border, #ccd0da);
    font: 12px/1.3 -apple-system, system-ui, sans-serif; color: var(--rl-text-dim, #56586a);
    display: flex; justify-content: space-between; align-items: center; gap: 10px;
  }
  #rl-source-status { color: var(--rl-text-dim, #56586a); font-size: 11px; }
  #rl-source-body { flex: 1; overflow: auto; min-height: 0; }
  #rl-source-pre {
    margin: 0; padding: 12px 14px; white-space: pre-wrap; word-break: break-word;
    font: 13px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--rl-text, #4c4f69);
  }
  #rl-editor-host { height: 100%; }
  @media (max-width: 768px) {
    body.rl-source-open main { margin-right: 0; }
    #rl-source-pane { width: 100vw; max-width: none; min-width: 0; }
  }
</style>
<style>

body.rl-watch { --topbar-h: 2.6rem; --fb-w: 0px; }
body.rl-watch.has-files,
body.rl-watch.has-files:has(nav.file-browser > details.fb-root:not([open])) { --fb-w: 0px; }
body.rl-watch main,
body.rl-watch.has-files main,
body.rl-watch.no-toc main,
body.rl-watch.has-files.no-toc main {
  margin-left: max(0px, calc(50% - 480px));
}
body.rl-watch.rl-source-open main,
body.rl-watch.has-files.rl-source-open main,
body.rl-watch.no-toc.rl-source-open main,
body.rl-watch.has-files.no-toc.rl-source-open main {
  margin-left: 0;
  margin-right: var(--rl-pane-w, 0px);
  max-width: none;
}
.rl-drawer-toggle {
  flex: none;
  margin-right: 0.45rem;
  font: 12px/1 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
  background: var(--rl-bg, #1e1e2e);
  color: var(--rl-text, #cdd6f4);
  border: 1px solid var(--rl-border, #313244);
  border-radius: 6px;
  padding: 5px 9px;
  cursor: pointer;
}
body.rl-drawer-open .rl-drawer-toggle {
  background: var(--rl-accent-primary, #cba6f7);
  color: var(--rl-bg, #1e1e2e);
  border-color: var(--rl-accent-primary, #cba6f7);
}
.rl-drawer-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: var(--topbar-h);
  z-index: 320;
  display: flex;
  align-items: center;
  padding: 0 0.6rem;
  background: var(--rl-bg-secondary, #181825);
  border-bottom: 1px solid var(--rl-border, #313244);
}
body.rl-watch:has(.rl-drawer-bar) main {
  padding-top: calc(var(--topbar-h) + 1.25rem);
}
#rl-drawer-scrim {
  position: fixed;
  top: var(--topbar-h);
  left: 0; right: 0; bottom: 0;
  z-index: 230;
  background: color-mix(in srgb, var(--rl-scrim, #11111b) 28%, transparent);
  opacity: 0;
  pointer-events: none;
}
body.rl-drawer-open #rl-drawer-scrim { opacity: 1; pointer-events: auto; }
#rl-drawer {
  position: fixed;
  top: var(--topbar-h);
  left: 0;
  bottom: 0;
  width: min(22rem, 88vw);
  z-index: 240;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--rl-bg-secondary, #181825);
  color: var(--rl-text, #cdd6f4);
  border-right: 1px solid var(--rl-border, #313244);
  box-shadow: 8px 0 28px color-mix(in srgb, var(--rl-shadow-color, #000000) 45%, transparent);
  transform: translateX(-105%);
  visibility: hidden;
  pointer-events: none;
}
body.rl-drawer-open #rl-drawer {
  transform: none;
  visibility: visible;
  pointer-events: auto;
}
#rl-drawer:focus { outline: none; }
#rl-drawer nav.file-browser,
#rl-drawer nav.sidebar {
  position: static;
  top: auto;
  left: auto;
  width: auto;
  height: auto;
  max-height: none;
  transform: none;
  box-shadow: none;
  border-right: 0;
  flex: 0 1 auto;
  overflow: auto;
}
#rl-drawer nav.file-browser {
  max-height: 46vh;
  border-bottom: 1px solid var(--rl-border, #313244);
}
#rl-drawer nav.sidebar { flex: 1 1 auto; }
body.rl-drawer-open .plot-container,
body.rl-drawer-open main h1,
body.rl-drawer-open main h2,
body.rl-drawer-open main h3 {
  margin-left: var(--rl-drawer-cover, 0px);
}
body.rl-drawer-open .plot-container {
  width: calc(100% - var(--rl-drawer-cover, 0px));
  max-width: calc(100% - var(--rl-drawer-cover, 0px));
}
@media (max-width: 768px) {
  body.rl-watch main,
  body.rl-watch.has-files main,
  body.rl-watch.no-toc main,
  body.rl-watch.has-files.no-toc main,
  body.rl-watch.rl-source-open main,
  body.rl-watch.has-files.rl-source-open main {
    margin-left: 0;
    margin-right: 0;
  }
  #rl-drawer nav.file-browser { transform: none; width: auto; }
}
@media (prefers-reduced-motion: reduce) {
  #rl-drawer { transition: none; }
}

</style>
</head>
<body class="rl-watch">
<header class="topbar"><button type="button" id="rl-drawer-toggle" class="rl-drawer-toggle" aria-expanded="false" aria-controls="rl-drawer" title="Contents (\)">Contents</button><span class="crumb"><span class="current">Sample</span><a class="rl-errors" href="#rl-error-1">1 error</a></span><span id="rl-cm-confirm" class="rl-cm-confirm" role="status"></span></header>


<script>
(function () {
  var box = document.getElementById('rl-comments');
  if (!box) return;
  function apply() {
    try {
      var v = sessionStorage.getItem('rl-comments-visible');
      if (v === '0') box.checked = false;
      else if (v === '1') box.checked = true;
    } catch (e) {}
    var c = document.getElementById('rl-cm-confirm');
    if (!c) return;
    try {
      var msg = sessionStorage.getItem('rl-cm-confirm');
      var until = parseInt(sessionStorage.getItem('rl-cm-confirm-until') || '0', 10);
      if (msg && Date.now() < until && !box.checked) c.textContent = msg;
      else c.textContent = '';
    } catch (e) {}
  }
  apply();
  box.addEventListener('change', function () {
    try { sessionStorage.setItem('rl-comments-visible', box.checked ? '1' : '0'); } catch (e) {}
    if (box.checked) {
      var c = document.getElementById('rl-cm-confirm');
      if (c) c.textContent = '';
      try { sessionStorage.removeItem('rl-cm-confirm'); } catch (e) {}
    }
  });
  var prev = window.__rlAfterUpdate;
  window.__rlAfterUpdate = function () {
    if (prev) prev();
    box = document.getElementById('rl-comments');
    if (box) apply();
    var menu = document.getElementById('rl-cm-menu');
    var pop = document.getElementById('rl-cm-pop');
    if (menu) menu.hidden = true;
    if (pop) pop.hidden = true;
  };
})();
</script>
