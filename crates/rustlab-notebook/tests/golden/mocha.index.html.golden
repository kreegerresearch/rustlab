<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Index — Notebook Index</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  :root {
    --rl-bg: #1e1e2e;
    --rl-bg-secondary: #181825;
    --rl-text: #cdd6f4;
    --rl-text-dim: #a6adc8;
    --rl-border: #313244;
    --rl-border-subtle: #45475a;
    --rl-accent-primary: #cba6f7;
    --rl-accent-secondary: #89b4fa;
    --rl-accent-tertiary: #74c7ec;
    --rl-code-bg: #11111b;
    --rl-output-bg: #181825;
    --rl-inline-code-bg: #313244;
    --rl-error-bg: #1e0a0a;
    --rl-error-text: #f38ba8;
    --rl-plot-bg: #1e1e2e;
    --rl-plot-grid: rgba(150,150,180,0.3);
    --rl-syn-keyword: #cba6f7;
    --rl-syn-function: #89b4fa;
    --rl-syn-number: #fab387;
    --rl-syn-string: #a6e3a1;
    --rl-syn-comment: #787c92;
    --rl-syn-operator: #89dceb;
    --rl-footer-text: #81859c;
    --rl-cm-mark-bg: #554f4e;
    --rl-cm-note-bg: #181825;
    --rl-cm-note-border: #89b4fa;
    --rl-dx-add-bar: #a6e3a1;
    --rl-dx-mod-bar: #89b4fa;
    --rl-dx-del-bar: #f38ba8;
    --rl-dx-add-line: #0f1211;
    --rl-dx-del-line: #161015;
    --rl-dx-add-word: #3c4947;
    --rl-dx-del-word: #4d3649;
  }
  html { color-scheme: dark; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--rl-bg, #1e1e2e);
    color: var(--rl-text, #cdd6f4);
    min-height: 100vh;
    padding: 3rem 1.5rem;
  }
  /* A block body with an auto-margin column, not a flex row: a nav or
     footer a host adds beside <main> stacks above or below it. */
  main {
    max-width: 720px;
    margin: 0 auto;
  }
  /* Every element rule is scoped to this page's own markup, so a link or
     list a site adds around the listing keeps its own look. */
  main > h1 {
    font-size: 2rem;
    color: var(--rl-accent-primary, #cba6f7);
    margin-bottom: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rl-border, #313244);
  }
  .subtitle {
    color: var(--rl-text-dim, #a6adc8);
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }
  ul.rl-index-list {
    list-style: none;
    padding: 0;
  }
  ul.rl-index-list > li {
    margin-bottom: 0.5rem;
  }
  ul.rl-index-list > li > a {
    display: block;
    padding: 0.8rem 1.2rem;
    background: var(--rl-bg-secondary, #181825);
    border: 1px solid var(--rl-border, #313244);
    border-radius: 8px;
    color: var(--rl-accent-secondary, #89b4fa);
    text-decoration: none;
    font-size: 1.05rem;
    transition: background 0.15s, border-color 0.15s;
  }
  ul.rl-index-list > li > a:hover {
    background: var(--rl-border, #313244);
    border-color: var(--rl-accent-secondary, #89b4fa);
  }
  main > footer {
    color: var(--rl-footer-text, #81859c);
    font-size: 0.8rem;
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rl-border, #313244);
  }
  .intro {
    color: var(--rl-text, #cdd6f4);
    margin-bottom: 2rem;
  }
  .intro p, .intro ul, .intro ol { margin-bottom: 1rem; }
  .intro ul, .intro ol { padding-left: 1.5rem; }
  .intro h2 { color: var(--rl-accent-primary, #cba6f7); margin: 1.5rem 0 0.5rem; }
  .intro a { color: var(--rl-accent-secondary, #89b4fa); text-decoration: underline; }
  .intro a:visited { color: var(--rl-accent-primary, #cba6f7); }
  .intro a:hover { color: var(--rl-accent-tertiary, #74c7ec); }
  body.has-files {
    padding: 0;
  }
  body.has-files main {
    margin-left: max(var(--fb-w, 16.5rem), calc(50% - 360px));
    padding: 3rem 1.5rem 2rem;
  }

</style>
</head>
<body>
<main>
<h1>Index</h1>
<p class="subtitle">1 notebook</p>
<div class="intro prose">
<p><a href="sample.html">Sample</a></p></div>
<ul class="rl-index-list">
  <li><a href="sample.html">Sample</a></li>
</ul>
<footer>Generated by rustlab-notebook</footer>
</main>
</body>
</html>
