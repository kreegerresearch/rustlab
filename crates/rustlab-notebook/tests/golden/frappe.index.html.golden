<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Index — Notebook Index</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  :root {
    --rl-bg: #303446;
    --rl-bg-secondary: #292c3c;
    --rl-text: #c6d0f5;
    --rl-text-dim: #aab2d1;
    --rl-border: #414559;
    --rl-border-subtle: #51576d;
    --rl-accent-primary: #cda4e7;
    --rl-accent-secondary: #98b3f0;
    --rl-accent-tertiary: #85c1dc;
    --rl-code-bg: #232634;
    --rl-output-bg: #292c3c;
    --rl-inline-code-bg: #414559;
    --rl-error-bg: #1e0a0a;
    --rl-error-text: #e78284;
    --rl-plot-bg: #303446;
    --rl-plot-grid: rgba(150,150,180,0.3);
    --rl-syn-keyword: #ca9ee6;
    --rl-syn-function: #8caaee;
    --rl-syn-number: #ef9f76;
    --rl-syn-string: #a6d189;
    --rl-syn-comment: #868ca3;
    --rl-syn-operator: #99d1db;
    --rl-footer-text: #979caf;
    --rl-cm-mark-bg: #545255;
    --rl-cm-note-bg: #292c3c;
    --rl-cm-note-border: #98b3f0;
    --rl-dx-add-bar: #a6d189;
    --rl-dx-mod-bar: #8caaee;
    --rl-dx-del-bar: #ec9b9d;
    --rl-dx-add-line: #222728;
    --rl-dx-del-line: #2b242c;
    --rl-dx-add-word: #4a5755;
    --rl-dx-del-word: #594b59;
  }
  html { color-scheme: dark; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--rl-bg, #303446);
    color: var(--rl-text, #c6d0f5);
    display: flex;
    justify-content: center;
    min-height: 100vh;
    padding: 3rem 1.5rem;
  }
  main {
    max-width: 720px;
    width: 100%;
  }
  h1 {
    font-size: 2rem;
    color: var(--rl-accent-primary, #cda4e7);
    margin-bottom: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rl-border, #414559);
  }
  .subtitle {
    color: var(--rl-text-dim, #aab2d1);
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }
  ul {
    list-style: none;
    padding: 0;
  }
  li {
    margin-bottom: 0.5rem;
  }
  a {
    display: block;
    padding: 0.8rem 1.2rem;
    background: var(--rl-bg-secondary, #292c3c);
    border: 1px solid var(--rl-border, #414559);
    border-radius: 8px;
    color: var(--rl-accent-secondary, #98b3f0);
    text-decoration: none;
    font-size: 1.05rem;
    transition: background 0.15s, border-color 0.15s;
  }
  a:hover {
    background: var(--rl-border, #414559);
    border-color: var(--rl-accent-secondary, #98b3f0);
  }
  footer {
    color: var(--rl-footer-text, #979caf);
    font-size: 0.8rem;
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rl-border, #414559);
  }
  .intro {
    color: var(--rl-text, #c6d0f5);
    margin-bottom: 2rem;
  }
  .intro p, .intro ul, .intro ol { margin-bottom: 1rem; }
  .intro h2 { color: var(--rl-accent-primary, #cda4e7); margin: 1.5rem 0 0.5rem; }
  .intro a {
    display: inline; padding: 0; background: transparent; border: 0;
    color: var(--rl-accent-secondary, #98b3f0); text-decoration: underline;
  }
  .intro a:visited { color: var(--rl-accent-primary, #cda4e7); }
  .intro a:hover { background: transparent; color: var(--rl-accent-tertiary, #85c1dc); }
  body.has-files {
    display: block;
    padding: 0;
    justify-content: flex-start;
  }
  body.has-files main {
    margin-left: max(var(--fb-w, 16.5rem), calc(50% - 360px));
    padding: 3rem 1.5rem 2rem;
  }

</style>
</head>
<body>
<main>
<h1>Index</h1>
<p class="subtitle">1 notebook</p>
<div class="intro prose">
<p><a href="sample.html">Sample</a></p></div>
<ul>
  <li><a href="sample.html">Sample</a></li>
</ul>
<footer>Generated by rustlab-notebook</footer>
</main>
</body>
</html>
