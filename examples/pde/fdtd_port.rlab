# Lumped port: one Ez gap in series with its own resistance
# Demonstrates: fdtd_port, fdtd_run, fdtd_s11, smith, rfplot
#
# The port is an open-circuit voltage Vg in series with Z0. Z0 is baked
# onto the edge as conductivity
#
#   σ = Δz / (Z0 · Δx · Δy)
#
# and the update subtracts (dt/ε0) · Cb · Vg / (Z0 · Area) from Ez.
# The recorded gap voltage is V = −Ez·Δz. The current is the Ampère loop
# around that edge, with the segment lengths of the Yee curl:
#
#   I = (Hy(i, j, k) − Hy(i, j−1, k)) · Δy
#     − (Hx(i, j, k) − Hx(i−1, j, k)) · Δx
#
# dx and dy differ below, so a swapped pair of lengths misses Z0.
# The lossy step is the recurrence
#
#   V(n) = Ca·V(n−1) + β·(Vg(n) − Z0·I(n))
#   s = σ·dt/(2·ε0),  Ca = (1−s)/(1+s),  β = 2s/(1+s)
#
# Solving it for Z0 is the resistance the port enforces. V/I is the
# impedance of the grid beyond the gap, which this small PEC box does
# not make equal to 50 ohm, so |S11| on the chart is that reflection.

dx = 1.0e-3;
dy = 1.5e-3;
dz = 0.5e-3;
z0 = 50;
sim = fdtd3d(12, 10, 10, dx, dy, dz);
info = fdtd_info(sim);
dt = info.dt;
mu0 = 1.25663706212e-6;
eps0 = 1 / (mu0 * info.c0^2);
tau = 80 * dt;
t0 = 4 * tau;
fdtd_port(sim, "ez", 5, 5, 5, z0, "gaussian", t0, tau);
out = fdtd_run(sim, 800);

V = out.V;
I = out.I;
n = out.steps;
t = (1:n) * dt;
vg = gaussian_pulse(t, t0, tau);

sigma = dz / (z0 * dx * dy);
s = sigma * dt / (2 * eps0);
ca = (1 - s) / (1 + s);
beta = 2 * s / (1 + s);
peak = max(abs(I));

# The update is a recurrence in V, so each sample uses the one before it.
worst = 0;
power = 0;
npow = 0;
for k = 2:n
  if abs(I(k)) >= 0.2 * peak
    zk = (vg(k) - (V(k) - ca * V(k - 1)) / beta) / I(k);
    err = abs(zk / z0 - 1);
    if err > worst
      worst = err;
    end
    if t(k) < t0
      power = power + V(k) * I(k);
      npow = npow + 1;
    end
  end
end
power = power / npow;

net = fdtd_s11(sim, "window", "rect");
from_samples = fdtd_s11(V, I, dt, z0, "window", "rect");
if max(abs(sij(net, 1, 1) - sij(from_samples, 1, 1))) != 0
  error("fdtd_s11(sim) and fdtd_s11(V, I, dt, Z0) disagree");
end

f = net.frequencies;
mag = abs(sij(net, 1, 1));
# NaN is not equal to itself, so this keeps the bins fdtd_s11 could form.
finite = mag == mag;
band = and(finite, and(f > 0.05 / tau, f < 2 / tau));
gb = mag(band);
fb = f(band);
at = argmin(gb);

fprintf("recovered Z0                 %.6f ohm\n", z0);
fprintf("worst relative error         %.3e\n", worst);
fprintf("mean V*I while rising        %.3e W\n", power);
fprintf("smallest |S11| in the band   %.3f at %.3f GHz\n", gb(at), fb(at) / 1e9);

if worst > 0.01
  error(sprintf("recovered resistance is %.3e relative to Z0 (1%% gate)", worst));
end
if power <= 0
  error("V*I on the rise is not into the grid");
end

subplot(2, 1, 1);
plot(t * 1e9, V);
xlabel("t (ns)");
ylabel("V (V)");
title("Gap voltage");
subplot(2, 1, 2);
plot(t * 1e9, I * 1e3);
xlabel("t (ns)");
ylabel("I (mA)");
title("Ampere current");

figure();
smith(net);
title("S11 of the gap");

figure();
rfplot(net);
title("|S11| of the gap");
